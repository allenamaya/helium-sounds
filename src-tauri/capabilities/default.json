{
  "$schema": "../schemas/capability-schema.json",
  "identifier": "default",
  "description": "Default permissions for Helium Sounds",
  "windows": ["main"],
  "permissions": [
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "core:resources:default",
    "core:menu:default",
    "dialog:allow-open",
